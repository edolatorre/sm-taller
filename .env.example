# Base de datos Postgres (Render Postgres en producción, local/Docker en desarrollo).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sm_taller

# Directorio donde se guardan los adjuntos (Render Disk en producción, carpeta local en desarrollo).
UPLOADS_DIR=./.uploads

# Proveedor de IA usado por el "Supervisor IA" (src/lib/ai).
# Valores soportados actualmente: openai
AI_PROVIDER=openai

# Credenciales del proveedor OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
